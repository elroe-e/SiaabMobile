# PostgreSQL connection. On cPanel: postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME (URL-encode @ : / in the password).
# Leave empty to run the storefront with the sample catalog.
DATABASE_URL=
# Optional: where uploaded phone photos are stored. Defaults to ~/siaab-photos, outside the app folder.
PHOTOS_DIR=
# Optional Gemini API key for admin-only assisted specification lookup.
GEMINI_API_KEY=
# Public website origin; used for canonical links, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://siaabmobile.com
# Optional display name for the Wikipedia API User-Agent.
WIKIPEDIA_USER_AGENT=SiaabMobileSpecs/1.0 (contact: hello@siaabmobile.com)

# Optional: force a Gemini model for spec lookup. Leave empty to let the app pick the newest Flash model.
GEMINI_MODEL=
