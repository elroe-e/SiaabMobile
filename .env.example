# Supabase project URL from Project Settings > API. Required to persist data.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key. Safe to expose publicly; RLS must remain enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role secret. Server/scripts only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional Gemini API key for admin-only assisted specification lookup.
GEMINI_API_KEY=
# Public website origin; update canonical links, sitemap and robots when deployed.
NEXT_PUBLIC_SITE_URL=https://siaabmobile.com
# Optional display name for the Wikipedia API User-Agent.
WIKIPEDIA_USER_AGENT=SiaabMobileSpecs/1.0 (contact: hello@siaabmobile.com)
# Local provisioning inputs. Never add these values to a deployed site's public variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
